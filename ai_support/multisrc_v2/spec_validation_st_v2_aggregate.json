{
  "name": "validation_st_v2_aggregate",
  "line_endings": "lf",
  "monitors": 5,
  "smc_horizon": 100000,
  "deterministic_host": true,
  "queue_policy": "drop_newest",
  "monitor": {
    "actuator": "ACTUATOR1",
    "period": 420
  },
  "nodes": [
    { "name": "SENSOR1", "wcet": 10, "prio": 6 },
    { "name": "SENSOR2", "wcet": 20, "prio": 5 },
    { "name": "FILTER1", "wcet": 10, "prio": -2 },
    { "name": "FILTER2", "wcet": 20, "prio": -3 },
    { "name": "FUSION1", "wcet": 30, "prio": -5 },
    { "name": "FILTER3", "wcet": 30, "prio": -6 },
    { "name": "ACTUATOR1", "wcet": 30, "prio": 4 }
  ],
  "generators": [
    {
      "name": "GEN_SENSOR1",
      "instance": "sensor1",
      "period_const": "SENSOR1_PERIOD",
      "deadline_const": "SENSOR1_DEADLINE",
      "period": 420,
      "deadline": 3000,
      "topic": "SENSOR1",
      "monitored": true,
      "prio": 6
    },
    {
      "name": "GEN_SENSOR2",
      "instance": "sensor2",
      "period_const": "SENSOR2_PERIOD",
      "deadline_const": "SENSOR2_DEADLINE",
      "period": 420,
      "deadline": 3000,
      "topic": "SENSOR2",
      "monitored": false,
      "prio": 5
    }
  ],
  "subscribers": [
    { "name": "filter1", "instance": "filter1", "task": "FILTER1", "signal_from": "SENSOR1" },
    { "name": "filter2", "instance": "filter2", "task": "FILTER2", "signal_from": "SENSOR2" },
    {
      "name": "fusion1",
      "instance": "fusion1",
      "task": "FUSION1",
      "signal_from": "FILTER1",
      "data_source": "pd",
      "src": "GEN_SENSOR1",
      "subprocesses": [
        {
          "name": "FUSION1xFILTER2",
          "instance": "fusion1xfilter2",
          "source": "FILTER2",
          "data_source": "pd",
          "src": "GEN_SENSOR2",
          "wcet": 30,
          "prio": -4
        }
      ]
    },
    { "name": "filter3", "instance": "filter3", "task": "FILTER3", "signal_from": "FUSION1" }
  ],
  "timers": [
    {
      "name": "ACTUATOR1_TIMER",
      "instance": "actuator1",
      "task": "ACTUATOR1",
      "period_const": "ACTUATOR1_TIMER_PERIOD",
      "delay_const": "ACTUATOR1_TIMER_DELAY",
      "period": 840,
      "delay": 0,
      "data_source": "DATA[ACTUATOR1XFILTER3]",
      "src": "GEN_SENSOR1",
      "subprocesses": [
        {
          "name": "ACTUATOR1xFILTER3",
          "instance": "actuator1xfilter3",
          "source": "FILTER3",
          "data_source": "pd",
          "src": "GEN_SENSOR1",
          "wcet": 30,
          "prio": -3
        }
      ]
    }
  ]
}
