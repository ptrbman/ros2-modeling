  ],
  "subscribers": [
    { "name": "filter1", "instance": "filter1", "task": "FILTER1", "signal_from": "SENSOR1" },
    { "name": "filter2", "instance": "filter2", "task": "FILTER2", "signal_from": "SENSOR2" },
