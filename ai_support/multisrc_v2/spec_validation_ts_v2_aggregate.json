  "nodes": [
    { "name": "SENSOR1", "wcet": 10, "prio": 6 },
    { "name": "SENSOR2", "wcet": 20, "prio": 5 },
    { "name": "FILTER1", "wcet": 10, "prio": -2 },
    { "name": "FILTER2", "wcet": 20, "prio": -3 },
    { "name": "FUSION1", "wcet": 30, "prio": -4 },
    { "name": "FILTER3", "wcet": 30, "prio": -7 },
    { "name": "ACTUATOR1", "wcet": 30, "prio": -8 }
  ],
  "generators": [
    {
      "name": "GEN_SENSOR1",
      "instance": "sensor1",
      "period_const": "SENSOR1_PERIOD",
      "deadline_const": "SENSOR1_DEADLINE",
      "period": 420,
      "deadline": 3000,
      "topic": "SENSOR1",
      "monitored": true,
      "prio": 6
    },
    {
      "name": "GEN_SENSOR2",
      "instance": "sensor2",
      "period_const": "SENSOR2_PERIOD",
